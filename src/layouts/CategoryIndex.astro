---
import ShowcaseBase from './ShowcaseBase.astro';

interface Variant {
  num: string;
  href: string;
  title: string;
  palette: string;
  fonts: string;
  mood: string;
  active: boolean;
}

interface Props {
  title: string;
  label: string;
  subtitle?: string;
  description: string;
  variants: Variant[];
}

const { title, label, subtitle, description, variants } = Astro.props;
const activeCount = variants.filter(v => v.active).length;
---

<ShowcaseBase title={`${label} Demos — Instatok`}>
  <style>
    :root {
      --bg:          #0a0908;
      --bg-2:        #111010;
      --ink:         #f7f3ea;
      --ink-soft:    #c8c0b4;
      --ink-dim:     #7a7068;
      --ink-faint:   #4a4540;
      --accent:      #ff6b3a;
      --warm:        #f5c17a;
      --line:        rgba(255,243,234,0.09);
      --line-strong: rgba(255,243,234,0.16);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Manrope', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100dvh;
    }

    .page { display: flex; flex-direction: column; min-height: 100dvh; }

    /* ── Nav ── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: color-mix(in srgb, var(--bg) 90%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
    }
    .nav-inner {
      max-width: 1240px; margin: 0 auto; padding: 16px 28px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 18px; letter-spacing: -0.035em;
      color: var(--ink); text-decoration: none;
    }
    .nav-logo-mark {
      width: 26px; height: 26px;
      position: relative; display: grid; place-items: center;
    }
    .nav-logo-mark::before {
      content: "";
      position: absolute; inset: 0; border-radius: 7px;
      background: conic-gradient(from 180deg at 50% 50%, var(--accent), var(--warm), var(--accent));
      animation: spin 8s linear infinite;
    }
    .nav-logo-mark::after {
      content: "";
      position: absolute; inset: 2px; border-radius: 6px;
      background: var(--bg);
    }
    .nav-logo-mark svg { position: relative; z-index: 1; width: 13px; height: 13px; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .nav-back {
      display: flex; align-items: center; gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-dim); text-decoration: none;
      padding: 5px 12px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      transition: color 0.2s, border-color 0.2s;
    }
    .nav-back:hover { color: var(--ink); border-color: rgba(255,107,58,0.4); }
    .nav-back svg { width: 10px; height: 10px; }

    /* ── Hero ── */
    .hero {
      padding: 56px 28px 44px;
      max-width: 1240px; margin: 0 auto; width: 100%;
      border-bottom: 1px solid var(--line-strong);
    }
    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px; font-weight: 600;
      color: var(--accent); letter-spacing: 0.16em; text-transform: uppercase;
      margin-bottom: 16px;
    }
    .hero-title {
      font-size: clamp(32px, 5vw, 60px);
      font-weight: 800; letter-spacing: -0.04em; line-height: 1;
      color: var(--ink); margin-bottom: 16px; text-wrap: balance;
    }
    .hero-title em {
      font-family: 'Instrument Serif', serif;
      font-style: italic; font-weight: 400;
      color: var(--ink-soft);
      letter-spacing: -0.02em;
    }
    .hero-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 600;
      color: var(--ink-faint); letter-spacing: 0.10em; text-transform: uppercase;
      margin-bottom: 12px;
    }
    .hero-sub {
      font-size: 15px; color: var(--ink-soft); line-height: 1.65;
      max-width: 500px; text-wrap: pretty;
    }

    /* ── Variants ── */
    .variants-wrap {
      padding: 0 28px 72px;
      max-width: 1240px; margin: 0 auto; width: 100%;
      flex: 1;
    }

    .variant-row {
      display: grid;
      grid-template-columns: 28px 1fr auto;
      align-items: baseline;
      gap: 28px;
      padding: 26px 0;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
      color: inherit;
    }
    .variant-row--active { cursor: pointer; }
    .variant-row--inactive { opacity: 0.35; cursor: default; }
    .variant-row--active:hover .variant-num { color: var(--accent); }
    .variant-row--active:hover .variant-title { color: var(--accent); }

    .variant-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px; font-weight: 500;
      color: var(--ink-faint); letter-spacing: 0.06em;
      padding-top: 2px;
      transition: color 0.15s;
    }

    .variant-body { display: flex; flex-direction: column; gap: 7px; }

    .variant-title {
      font-size: 17px; font-weight: 700;
      letter-spacing: -0.02em; line-height: 1.2;
      color: var(--ink);
      transition: color 0.15s;
    }

    .variant-tags {
      display: flex; flex-wrap: wrap; gap: 5px;
    }
    .variant-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; font-weight: 600;
      letter-spacing: 0.10em; text-transform: uppercase;
      color: var(--ink-dim);
      border: 1px solid var(--line-strong);
      padding: 2px 7px; border-radius: 3px;
    }

    .variant-mood {
      font-size: 13px; color: var(--ink-soft); line-height: 1.6;
    }

    .variant-cta {
      display: flex; align-items: center; gap: 5px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--accent); white-space: nowrap;
      transition: gap 0.15s;
    }
    .variant-cta svg { width: 9px; height: 9px; transition: transform 0.15s; }
    .variant-row--active:hover .variant-cta { gap: 8px; }
    .variant-row--active:hover .variant-cta svg { transform: translateX(2px); }

    .variant-soon {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-faint);
    }

    /* ── Footer ── */
    .footer {
      padding: 20px 28px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; flex-wrap: wrap;
    }
    .footer p {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px; color: var(--ink-faint); letter-spacing: 0.06em;
    }

    @media (max-width: 640px) {
      .hero { padding: 40px 20px 32px; }
      .variants-wrap { padding: 0 20px 56px; }
      .nav-inner { padding: 14px 20px; }
      .footer { padding: 16px 20px; }
      .variant-row { grid-template-columns: 24px 1fr; gap: 16px; }
      .variant-cta, .variant-soon { grid-column: 2; padding-top: 4px; }
      .variant-title { font-size: 15px; }
    }
  </style>

  <div class="page">

    <!-- Nav -->
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <span class="nav-logo-mark">
            <svg viewBox="0 0 14 14" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12L7 2l5 10"/>
              <path d="M4 8h6"/>
            </svg>
          </span>
          Instatok
        </a>
        <a href="/" class="nav-back">
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L2 5l4 3"/>
          </svg>
          Όλες οι κατηγορίες
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <p class="eyebrow">Κατηγορία</p>
      <h1 class="hero-title">
        {label}{subtitle ? <><br /><em>— {subtitle}</em></> : ''}
      </h1>
      <p class="hero-count">{activeCount} demo{activeCount !== 1 ? 's' : ''} διαθέσιμ{activeCount !== 1 ? 'α' : 'ο'}</p>
      <p class="hero-sub">{description}</p>
    </section>

    <!-- Variants -->
    <div class="variants-wrap">
      {variants.map(v => (
        v.active
          ? (
            <a href={v.href} class="variant-row variant-row--active">
              <span class="variant-num">{v.num}</span>
              <div class="variant-body">
                <span class="variant-title">{v.title}</span>
                {(v.palette !== '—' || v.fonts !== '—') && (
                  <div class="variant-tags">
                    {v.palette !== '—' && <span class="variant-tag">{v.palette}</span>}
                    {v.fonts !== '—' && <span class="variant-tag">{v.fonts}</span>}
                  </div>
                )}
                <span class="variant-mood">{v.mood}</span>
              </div>
              <span class="variant-cta">
                Άνοιγμα
                <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 5h6M5 2l3 3-3 3"/>
                </svg>
              </span>
            </a>
          ) : (
            <div class="variant-row variant-row--inactive">
              <span class="variant-num">{v.num}</span>
              <div class="variant-body">
                <span class="variant-title">{v.title}</span>
                <span class="variant-mood">{v.mood}</span>
              </div>
              <span class="variant-soon">Soon</span>
            </div>
          )
      ))}
    </div>

    <!-- Footer -->
    <footer class="footer">
      <p>© {new Date().getFullYear()} Instatok</p>
      <p>Demos for review only</p>
    </footer>

  </div>
</ShowcaseBase>
