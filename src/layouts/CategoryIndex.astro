---
import ShowcaseBase from './ShowcaseBase.astro';

interface Variant {
  num: string;
  href: string;
  title: string;
  palette: string;
  fonts: string;
  mood: string;
  active: boolean;
  thumb?: string;
}

interface Props {
  title: string;
  label: string;
  subtitle?: string;
  description: string;
  variants: Variant[];
}

const { title, label, subtitle, description, variants } = Astro.props;
const activeVariants = variants.filter(v => v.active);
const inactiveVariants = variants.filter(v => !v.active);
const n = activeVariants.length;
---

<ShowcaseBase title={`${label} Demos — Instatok`}>
  <style>
    :root {
      --bg:          #0a0908;
      --bg-2:        #111010;
      --bg-card:     #141210;
      --ink:         #f7f3ea;
      --ink-soft:    #c8c0b4;
      --ink-dim:     #7a7068;
      --ink-faint:   #4a4540;
      --accent:      #ff6b3a;
      --warm:        #f5c17a;
      --line:        rgba(255,243,234,0.09);
      --line-strong: rgba(255,243,234,0.16);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Manrope', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100dvh;
    }

    .page { display: flex; flex-direction: column; min-height: 100dvh; }

    /* ── Nav ── */
    .nav {
      position: sticky; top: 0; z-index: 100;
      background: color-mix(in srgb, var(--bg) 90%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
    }
    .nav-inner {
      max-width: 1300px; margin: 0 auto; padding: 16px 28px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo { display: flex; align-items: center; text-decoration: none; }
    .nav-back {
      display: flex; align-items: center; gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-dim); text-decoration: none;
      padding: 5px 12px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      transition: color 0.2s, border-color 0.2s;
    }
    .nav-back:hover { color: var(--ink); border-color: rgba(255,107,58,0.4); }
    .nav-back svg { width: 10px; height: 10px; }

    /* ── Hero ── */
    .hero {
      padding: 48px 28px 36px;
      max-width: 1300px; margin: 0 auto; width: 100%;
    }
    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 600;
      color: var(--accent); letter-spacing: 0.16em; text-transform: uppercase;
      margin-bottom: 10px;
    }
    .hero-title {
      font-size: clamp(28px, 4vw, 48px);
      font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
      color: var(--ink); margin-bottom: 8px;
    }
    .hero-title em {
      font-family: 'Instrument Serif', serif;
      font-style: italic; font-weight: 400;
      color: var(--ink-soft); letter-spacing: -0.02em;
    }
    .hero-meta {
      display: flex; align-items: center; gap: 16px; margin-top: 10px;
    }
    .hero-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 600;
      color: var(--ink-faint); letter-spacing: 0.10em; text-transform: uppercase;
    }
    .hero-sub {
      font-size: 14px; color: var(--ink-dim); line-height: 1.6;
    }

    /* ── Main grid ── */
    .main {
      padding: 0 28px 64px;
      max-width: 1300px; margin: 0 auto; width: 100%;
      flex: 1;
    }

    .demo-grid {
      display: grid;
      gap: 16px;
    }
    .demo-grid[data-cols="1"] { grid-template-columns: minmax(0, 540px); }
    .demo-grid[data-cols="2"] { grid-template-columns: repeat(2, 1fr); }
    .demo-grid[data-cols="3"] { grid-template-columns: repeat(3, 1fr); }
    .demo-grid[data-cols="4"] { grid-template-columns: repeat(4, 1fr); }

    /* ── Demo card ── */
    .dc {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      display: flex; flex-direction: column;
      transition: border-color 0.2s, transform 0.2s;
      text-decoration: none; color: inherit;
    }
    .dc:hover {
      border-color: rgba(255,107,58,0.35);
      transform: translateY(-2px);
    }

    /* Browser chrome */
    .dc-chrome {
      background: #1c1917;
      border-bottom: 1px solid var(--line);
      padding: 7px 10px;
      display: flex; align-items: center; gap: 8px;
      flex-shrink: 0;
    }
    .dc-dots {
      display: flex; gap: 4px; flex-shrink: 0;
    }
    .dc-dots span {
      width: 7px; height: 7px; border-radius: 50%;
    }
    .dc-dots span:nth-child(1) { background: #ff5f57; }
    .dc-dots span:nth-child(2) { background: #febc2e; }
    .dc-dots span:nth-child(3) { background: #28c840; }
    .dc-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-faint);
      letter-spacing: 0.04em;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      flex: 1; min-width: 0;
    }

    /* Screenshot */
    .dc-screen {
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #1a1614;
      position: relative;
    }
    .dc-screen img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: top center;
      display: block;
    }
    .dc-screen-empty {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
    }
    .dc-screen-empty span {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; color: var(--ink-faint); letter-spacing: 0.08em;
    }

    /* Card info */
    .dc-info {
      padding: 11px 13px 13px;
      display: flex; flex-direction: column; gap: 6px;
      flex: 1;
    }
    .dc-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; color: var(--accent); letter-spacing: 0.06em;
    }
    .dc-title {
      font-size: 17px; font-weight: 700;
      letter-spacing: -0.01em; line-height: 1.2;
      color: var(--ink);
    }
    .dc-tags {
      display: flex; flex-wrap: wrap; gap: 5px;
    }
    .dc-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--warm);
      background: rgba(245,193,122,0.07);
      border: 1px solid rgba(245,193,122,0.16);
      padding: 4px 9px; border-radius: 4px;
    }
    .dc-tag:nth-child(2n) {
      color: rgba(255,107,58,0.8);
      background: rgba(255,107,58,0.07);
      border-color: rgba(255,107,58,0.18);
    }
    .dc-cta {
      margin-top: auto; padding-top: 10px;
    }
    .dc-cta-btn {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--accent);
      color: #0a0908;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.10em; text-transform: uppercase;
      padding: 9px 16px; border-radius: 6px;
      transition: background 0.15s;
    }
    .dc:hover .dc-cta-btn { background: #ff8255; }
    .dc-cta-btn svg { width: 10px; height: 10px; transition: transform 0.15s; }
    .dc:hover .dc-cta-btn svg { transform: translateX(3px); }

    /* ── Inactive variants ── */
    .inactive-section {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
    }
    .inactive-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; font-weight: 600;
      color: var(--ink-faint); letter-spacing: 0.14em; text-transform: uppercase;
      margin-bottom: 12px;
    }
    .inactive-list {
      display: flex; flex-wrap: wrap; gap: 8px;
    }
    .inactive-item {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-faint);
      background: var(--bg-2);
      border: 1px solid var(--line);
      padding: 4px 10px; border-radius: 4px;
      opacity: 0.5;
    }

    /* ── Footer ── */
    .footer {
      padding: 20px 28px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; flex-wrap: wrap;
    }
    .footer p {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px; color: var(--ink-faint); letter-spacing: 0.06em;
    }

    /* ── Responsive ── */
    @media (max-width: 1100px) {
      .demo-grid[data-cols="4"] { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 860px) {
      .demo-grid[data-cols="3"],
      .demo-grid[data-cols="4"] { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .hero { padding: 36px 16px 24px; }
      .main { padding: 0 16px 48px; }
      .nav-inner { padding: 14px 16px; }
      .footer { padding: 16px 16px; }
      .demo-grid[data-cols="2"],
      .demo-grid[data-cols="3"],
      .demo-grid[data-cols="4"] { grid-template-columns: 1fr; }
    }
  </style>

  <div class="page">

    <!-- Nav -->
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <img src="/assets/logo-horizontal.webp" alt="Instatok" height="30" style="display:block;width:auto">
        </a>
        <a href="/" class="nav-back">
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L2 5l4 3"/>
          </svg>
          Όλες οι κατηγορίες
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <p class="eyebrow">Κατηγορία</p>
      <h1 class="hero-title">
        {label}{subtitle ? <><br /><em>— {subtitle}</em></> : ''}
      </h1>
      <div class="hero-meta">
        <span class="hero-count">{n} demo{n !== 1 ? 's' : ''} διαθέσιμ{n !== 1 ? 'α' : 'ο'}</span>
        <span class="hero-sub">{description}</span>
      </div>
    </section>

    <!-- Demo cards -->
    <div class="main">
      <div class="demo-grid" data-cols={String(Math.min(n, 4))}>
        {activeVariants.map(v => {
          const path = v.href;
          return (
            <a href={v.href} class="dc" target="_blank">
              <div class="dc-chrome">
                <div class="dc-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="dc-url">demo.instatok.gr{path}</div>
              </div>
              <div class="dc-screen">
                {v.thumb
                  ? <img src={v.thumb} alt={v.title} loading="lazy" />
                  : <div class="dc-screen-empty"><span>preview soon</span></div>
                }
              </div>
              <div class="dc-info">
                <div class="dc-num">{v.num}</div>
                <div class="dc-title">{v.title}</div>
                {(v.palette !== '—' || v.fonts !== '—') && (
                  <div class="dc-tags">
                    {v.palette !== '—' && <span class="dc-tag">{v.palette}</span>}
                    {v.fonts !== '—' && <span class="dc-tag">{v.fonts}</span>}
                  </div>
                )}
                <div class="dc-cta">
                  <span class="dc-cta-btn">
                    Δες το live
                    <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 5h6M5 2l3 3-3 3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {inactiveVariants.length > 0 && (
        <div class="inactive-section">
          <p class="inactive-label">Σύντομα</p>
          <div class="inactive-list">
            {inactiveVariants.map(v => (
              <span class="inactive-item">{v.num} · {v.title}</span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Footer -->
    <footer class="footer">
      <p>© {new Date().getFullYear()} Instatok</p>
      <p>Demos for review only</p>
    </footer>

  </div>
</ShowcaseBase>
