---
import ShowcaseBase from './ShowcaseBase.astro';

interface Variant {
  num: string;
  href: string;
  title: string;
  palette: string;
  fonts: string;
  mood: string;
  active: boolean;
}

interface Props {
  title: string;
  label: string;
  subtitle?: string;
  description: string;
  variants: Variant[];
}

const { title, label, subtitle, description, variants } = Astro.props;
const activeCount = variants.filter(v => v.active).length;
---

<ShowcaseBase title={`${label} Demos — Instatok`}>
  <style>
    :root {
      --bg:          #0a0908;
      --bg-2:        #141110;
      --bg-3:        #1d1917;
      --bg-card:     #1a1614;
      --ink:         #f7f3ea;
      --ink-soft:    #e0d9cc;
      --ink-dim:     #8a8278;
      --ink-faint:   #56514a;
      --accent:      #ff6b3a;
      --accent-hot:  #ff4500;
      --accent-soft: rgba(255,107,58,0.12);
      --accent-line: rgba(255,107,58,0.35);
      --warm:        #f5c17a;
      --line:        rgba(255,243,234,0.08);
      --line-strong: rgba(255,243,234,0.15);
      --radius:      16px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Manrope', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100dvh;
    }

    body::before {
      content: "";
      position: fixed; inset: 0;
      background:
        radial-gradient(1200px circle at 10% 0%, rgba(245,193,122,0.04), transparent 55%),
        radial-gradient(900px  circle at 90% 25%, rgba(255,243,234,0.02), transparent 55%);
      pointer-events: none; z-index: 0;
    }
    body::after {
      content: "";
      position: fixed; inset: 0;
      pointer-events: none; z-index: 1;
      opacity: 0.3; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    }

    .page { position: relative; z-index: 2; display: flex; flex-direction: column; min-height: 100dvh; }

    /* ── Nav ── */
    .nav {
      position: sticky; top: 0;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      border-bottom: 1px solid var(--line);
      z-index: 100;
    }
    .nav-inner {
      max-width: 1240px; margin: 0 auto; padding: 16px 28px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 18px; letter-spacing: -0.035em;
      color: var(--ink); text-decoration: none;
    }
    .nav-logo-mark {
      width: 26px; height: 26px;
      position: relative; display: grid; place-items: center;
    }
    .nav-logo-mark::before {
      content: "";
      position: absolute; inset: 0; border-radius: 7px;
      background: conic-gradient(from 180deg at 50% 50%, var(--accent), var(--warm), var(--accent));
      animation: spin 8s linear infinite;
    }
    .nav-logo-mark::after {
      content: "";
      position: absolute; inset: 2px; border-radius: 6px;
      background: var(--bg);
    }
    .nav-logo-mark svg { position: relative; z-index: 1; width: 13px; height: 13px; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .nav-back {
      display: flex; align-items: center; gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-dim); text-decoration: none;
      padding: 5px 12px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      transition: color 0.2s, border-color 0.2s;
    }
    .nav-back:hover { color: var(--ink); border-color: var(--accent-line); }
    .nav-back svg { width: 10px; height: 10px; }

    /* ── Hero ── */
    .hero {
      padding: 64px 28px 48px;
      max-width: 1240px; margin: 0 auto; width: 100%;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 500;
      color: var(--accent); letter-spacing: 0.14em; text-transform: uppercase;
      margin-bottom: 20px;
    }
    .eyebrow::before { content: ""; width: 24px; height: 1px; background: var(--accent); }

    .hero-title {
      font-size: clamp(36px, 5.5vw, 68px);
      font-weight: 800; letter-spacing: -0.04em; line-height: 1;
      color: var(--ink); margin-bottom: 16px; text-wrap: balance;
    }
    .hero-title em {
      font-family: 'Instrument Serif', serif;
      font-style: italic; font-weight: 400;
      color: var(--ink-dim);
      letter-spacing: -0.02em;
    }
    .hero-meta {
      display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .hero-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-dim);
      background: var(--bg-2); border: 1px solid var(--line-strong);
      padding: 4px 10px; border-radius: 999px;
    }
    .hero-sub {
      font-size: 16px; color: var(--ink-dim); line-height: 1.6;
      max-width: 520px; text-wrap: pretty;
    }

    /* ── Variants list ── */
    .variants-wrap {
      padding: 0 28px 80px;
      max-width: 1240px; margin: 0 auto; width: 100%;
      flex: 1;
    }
    .variants-list {
      border-top: 1px solid var(--line-strong);
    }
    .variant-row {
      display: grid;
      grid-template-columns: 32px 1fr auto;
      align-items: start;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
      color: inherit;
      transition: background 0.15s;
      position: relative;
    }
    .variant-row--active { cursor: pointer; }
    .variant-row--active:hover { background: transparent; }
    .variant-row--active:hover .variant-num { color: var(--accent); }
    .variant-row--active:hover .variant-title { color: var(--ink); }
    .variant-row--inactive { opacity: 0.35; cursor: default; }

    .variant-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 500;
      color: var(--ink-faint);
      letter-spacing: 0.06em;
      padding-top: 3px;
      transition: color 0.2s;
    }

    .variant-body { display: flex; flex-direction: column; gap: 8px; }

    .variant-title {
      font-size: 18px; font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--ink-soft);
      line-height: 1.2;
      transition: color 0.2s;
    }

    .variant-tags {
      display: flex; flex-wrap: wrap; gap: 6px;
      align-items: center;
    }
    .variant-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--ink-faint);
      background: var(--bg-2);
      border: 1px solid var(--line);
      padding: 3px 8px; border-radius: 4px;
    }

    .variant-mood {
      font-size: 13.5px; color: var(--ink-dim); line-height: 1.55;
    }

    .variant-cta {
      display: flex; align-items: center; gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--accent);
      white-space: nowrap;
      padding-top: 4px;
      transition: gap 0.2s;
    }
    .variant-cta svg { width: 10px; height: 10px; transition: transform 0.2s; }
    .variant-row--active:hover .variant-cta { gap: 9px; }
    .variant-row--active:hover .variant-cta svg { transform: translateX(2px); }

    .variant-soon {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-faint);
      padding-top: 4px;
    }

    /* ── Footer ── */
    .footer {
      padding: 24px 28px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; flex-wrap: wrap;
    }
    .footer p {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-faint); letter-spacing: 0.06em;
    }

    @media (max-width: 640px) {
      .hero { padding: 48px 20px 36px; }
      .variants-wrap { padding: 0 20px 60px; }
      .nav-inner { padding: 14px 20px; }
      .footer { padding: 20px; }
      .variant-row { grid-template-columns: 24px 1fr; gap: 16px; }
      .variant-cta, .variant-soon { grid-column: 2; }
      .variant-title { font-size: 16px; }
    }
  </style>

  <div class="page">

    <!-- Nav -->
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <span class="nav-logo-mark">
            <svg viewBox="0 0 14 14" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12L7 2l5 10"/>
              <path d="M4 8h6"/>
            </svg>
          </span>
          Instatok
        </a>
        <a href="/" class="nav-back">
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L2 5l4 3"/>
          </svg>
          Όλες οι κατηγορίες
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <p class="eyebrow">Κατηγορία</p>
      <h1 class="hero-title">
        {label}{subtitle ? <><br /><em>— {subtitle}</em></> : ''}
      </h1>
      <div class="hero-meta">
        <span class="hero-count">{activeCount} demo{activeCount !== 1 ? 's' : ''} διαθέσιμ{activeCount !== 1 ? 'α' : 'ο'}</span>
      </div>
      <p class="hero-sub">{description}</p>
    </section>

    <!-- Variants -->
    <div class="variants-wrap">
      <div class="variants-list">
        {variants.map(v => (
          v.active
            ? (
              <a href={v.href} class="variant-row variant-row--active">
                <span class="variant-num">{v.num}</span>
                <div class="variant-body">
                  <span class="variant-title">{v.title}</span>
                  {(v.palette !== '—' || v.fonts !== '—') && (
                    <div class="variant-tags">
                      {v.palette !== '—' && <span class="variant-tag">{v.palette}</span>}
                      {v.fonts !== '—' && <span class="variant-tag">{v.fonts}</span>}
                    </div>
                  )}
                  <span class="variant-mood">{v.mood}</span>
                </div>
                <span class="variant-cta">
                  Άνοιγμα
                  <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 5h6M5 2l3 3-3 3"/>
                  </svg>
                </span>
              </a>
            ) : (
              <div class="variant-row variant-row--inactive">
                <span class="variant-num">{v.num}</span>
                <div class="variant-body">
                  <span class="variant-title">{v.title}</span>
                  <span class="variant-mood">{v.mood}</span>
                </div>
                <span class="variant-soon">Soon</span>
              </div>
            )
        ))}
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <p>© {new Date().getFullYear()} Instatok</p>
      <p>Demos for review only — not for public distribution</p>
    </footer>

  </div>
</ShowcaseBase>
