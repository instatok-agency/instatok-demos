---
import ShowcaseBase from '../layouts/ShowcaseBase.astro';

const categories = [
  {
    slug: 'psychologos',
    label: 'Ψυχολόγος',
    subtitle: 'Psychologist',
    count: 2,
    description: 'Ζεστή αισθητική για επαγγελματίες ψυχικής υγείας.',
    tag: 'Aegean · Pangrati',
  },
  {
    slug: 'architect',
    label: 'Αρχιτέκτονας',
    subtitle: 'Architect',
    count: 1,
    description: 'Swiss minimalism για αρχιτεκτονικά γραφεία.',
    tag: 'Swiss',
  },
  {
    slug: 'lawyer',
    label: 'Δικηγόρος',
    subtitle: 'Lawyer',
    count: 0,
    description: 'Σύντομα.',
    tag: null,
  },
  {
    slug: 'doctor',
    label: 'Ιατρός',
    subtitle: 'Doctor',
    count: 0,
    description: 'Σύντομα.',
    tag: null,
  },
  {
    slug: 'yoga',
    label: 'Yoga / Pilates',
    subtitle: 'Yoga Instructor',
    count: 3,
    description: 'Editorial somatic αισθητική για δασκάλες yoga και pilates.',
    tag: 'Intelligence · Modern · Retreat',
  },
  {
    slug: 'cafe',
    label: 'Καφετέρια',
    subtitle: 'Specialty Café',
    count: 2,
    description: 'Σκοτεινή και cinematic αισθητική για specialty coffee shops και cocktail bars.',
    tag: 'DarkBar · NYX',
  },
  {
    slug: 'coach',
    label: 'Coach / Consultant',
    subtitle: 'Coach & Consultant',
    count: 3,
    description: 'Life coaches, executive coaches και στρατηγικούς συμβούλους.',
    tag: 'Insider · Modern · Consultant',
  },
  {
    slug: 'hospitality',
    label: 'Hospitality',
    subtitle: 'BNB · Hotel · Resort',
    count: 4,
    description: 'Editorial, urban dark, heritage Mediterranean και boutique island resort.',
    tag: 'Arch · Dark · Editorial · Rivora',
  },
];
---

<ShowcaseBase title="Instatok · Demos">
  <style>
    :root {
      --bg:          #0a0908;
      --bg-2:        #141110;
      --bg-3:        #1d1917;
      --bg-card:     #1a1614;
      --ink:         #f7f3ea;
      --ink-soft:    #e0d9cc;
      --ink-dim:     #8a8278;
      --ink-faint:   #56514a;
      --accent:      #ff6b3a;
      --accent-hot:  #ff4500;
      --accent-soft: rgba(255,107,58,0.12);
      --accent-line: rgba(255,107,58,0.35);
      --warm:        #f5c17a;
      --line:        rgba(255,243,234,0.08);
      --line-strong: rgba(255,243,234,0.15);
      --radius:      16px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Manrope', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100dvh;
    }

    /* Noise + radial glow */
    body::before {
      content: "";
      position: fixed; inset: 0;
      background:
        radial-gradient(1200px circle at 10% 0%, rgba(245,193,122,0.04), transparent 55%),
        radial-gradient(900px  circle at 90% 25%, rgba(255,243,234,0.02), transparent 55%);
      pointer-events: none; z-index: 0;
    }
    body::after {
      content: "";
      position: fixed; inset: 0;
      pointer-events: none; z-index: 1;
      opacity: 0.3; mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    }

    .page { position: relative; z-index: 2; display: flex; flex-direction: column; min-height: 100dvh; }

    /* ── Nav ─────────────────────────────── */
    .nav {
      position: sticky; top: 0;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(16px) saturate(180%);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      border-bottom: 1px solid var(--line);
      z-index: 100;
    }
    .nav-inner {
      max-width: 1240px; margin: 0 auto; padding: 16px 28px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 10px;
      font-weight: 800; font-size: 18px; letter-spacing: -0.035em;
      color: var(--ink); text-decoration: none;
    }
    .nav-logo-mark {
      width: 26px; height: 26px;
      position: relative; display: grid; place-items: center;
    }
    .nav-logo-mark::before {
      content: "";
      position: absolute; inset: 0; border-radius: 7px;
      background: conic-gradient(from 180deg at 50% 50%, var(--accent), var(--warm), var(--accent));
      animation: spin 8s linear infinite;
    }
    .nav-logo-mark::after {
      content: "";
      position: absolute; inset: 2px; border-radius: 6px;
      background: var(--bg);
    }
    .nav-logo-mark svg { position: relative; z-index: 1; width: 13px; height: 13px; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .nav-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 500;
      color: var(--ink-dim); letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 4px 10px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
    }

    /* ── Marquee strip ───────────────────── */
    .marquee {
      background: var(--accent); color: #0a0908;
      overflow: hidden; border-bottom: 1px solid rgba(0,0,0,0.2);
    }
    .marquee-track {
      display: flex; gap: 40px; padding: 10px 0;
      animation: marquee-scroll 30s linear infinite;
      white-space: nowrap;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px; font-weight: 600; letter-spacing: 0.04em;
    }
    .marquee-track span { display: inline-flex; align-items: center; gap: 40px; }
    .marquee-track span::after { content: "✦"; color: rgba(0,0,0,0.3); }
    @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ── Hero ────────────────────────────── */
    .hero {
      padding: 72px 28px 64px;
      max-width: 1240px; margin: 0 auto; width: 100%;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 500;
      color: var(--accent); letter-spacing: 0.14em; text-transform: uppercase;
      margin-bottom: 24px;
    }
    .eyebrow::before { content: ""; width: 24px; height: 1px; background: var(--accent); }

    .hero-title {
      font-size: clamp(40px, 6vw, 76px);
      font-weight: 800; letter-spacing: -0.04em; line-height: 1;
      color: var(--ink); margin-bottom: 20px; text-wrap: balance;
    }
    .hero-title em {
      font-family: 'Instrument Serif', serif;
      font-style: italic; font-weight: 400;
      background: linear-gradient(135deg, var(--accent) 0%, var(--warm) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
      letter-spacing: -0.02em;
    }
    .hero-sub {
      font-size: 17px; color: var(--ink-dim); line-height: 1.6;
      max-width: 560px; text-wrap: pretty;
    }

    /* ── Grid ────────────────────────────── */
    .grid-wrap {
      padding: 0 28px 80px;
      max-width: 1240px; margin: 0 auto; width: 100%;
    }
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media (max-width: 1024px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px)  { .cat-grid { grid-template-columns: 1fr; } }

    .cat-card {
      background: var(--bg-card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px;
      display: flex; flex-direction: column; gap: 12px;
      text-decoration: none; color: inherit;
      transition: border-color 0.2s, background 0.2s, transform 0.2s;
      position: relative; overflow: hidden;
    }
    .cat-card:not(.cat-card--inactive):hover {
      border-color: var(--accent-line);
      background: var(--bg-3);
      transform: translateY(-2px);
    }
    .cat-card--inactive { cursor: default; opacity: 0.45; }

    .cat-card-top {
      display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
    }
    .cat-label {
      font-size: 20px; font-weight: 700;
      letter-spacing: -0.02em; color: var(--ink); line-height: 1.1;
    }
    .cat-subtitle {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 4px;
    }
    .cat-count {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-dim);
      background: var(--bg-2); border: 1px solid var(--line-strong);
      padding: 3px 8px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
    }
    .cat-soon {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-faint); flex-shrink: 0;
    }
    .cat-desc {
      font-size: 13px; color: var(--ink-dim); line-height: 1.6; flex: 1;
    }
    .cat-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px; color: var(--ink-faint);
      letter-spacing: 0.06em; line-height: 1.5;
    }
    .cat-cta {
      display: flex; align-items: center; gap: 8px;
      margin-top: 4px; padding-top: 14px;
      border-top: 1px solid var(--line);
    }
    .cat-cta-label {
      font-size: 10px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--accent);
    }
    .cat-cta svg { width: 12px; height: 12px; color: var(--accent); transition: transform 0.2s; }
    .cat-card:not(.cat-card--inactive):hover .cat-cta svg { transform: translateX(3px); }

    /* ── Footer ──────────────────────────── */
    .footer {
      margin-top: auto;
      padding: 24px 28px;
      border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center;
      gap: 12px; flex-wrap: wrap;
    }
    .footer p {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: var(--ink-faint); letter-spacing: 0.06em;
    }

    @media (max-width: 640px) {
      .hero { padding: 48px 20px 40px; }
      .grid-wrap { padding: 0 20px 60px; }
      .nav-inner { padding: 14px 20px; }
      .footer { padding: 20px; }
      .marquee-track { font-size: 10.5px; gap: 28px; }
      .marquee-track span { gap: 28px; }
    }
  </style>

  <div class="page">

    <!-- Marquee -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Ψυχολόγος</span>
        <span>Αρχιτέκτονας</span>
        <span>Yoga / Pilates</span>
        <span>Καφετέρια</span>
        <span>Coach</span>
        <span>Hospitality</span>
        <span>Ψυχολόγος</span>
        <span>Αρχιτέκτονας</span>
        <span>Yoga / Pilates</span>
        <span>Καφετέρια</span>
        <span>Coach</span>
        <span>Hospitality</span>
      </div>
    </div>

    <!-- Nav -->
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">
          <span class="nav-logo-mark">
            <svg viewBox="0 0 14 14" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12L7 2l5 10"/>
              <path d="M4 8h6"/>
            </svg>
          </span>
          Instatok
        </a>
        <span class="nav-badge">demo.instatok.gr</span>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <p class="eyebrow">Βιτρίνα</p>
      <h1 class="hero-title">
        Δείγματα<br />
        <em>ψηφιακής παρουσίας.</em>
      </h1>
      <p class="hero-sub">
        Έτοιμα demos για Έλληνες επαγγελματίες. Κάθε κατηγορία περιέχει 1–4 διαφορετικές αισθητικές κατευθύνσεις.
      </p>
    </section>

    <!-- Categories grid -->
    <section class="grid-wrap">
      <div class="cat-grid">
        {categories.map(cat => (
          <a
            href={cat.count > 0 ? `/${cat.slug}` : undefined}
            class={`cat-card${cat.count === 0 ? ' cat-card--inactive' : ''}`}
          >
            <div class="cat-card-top">
              <div>
                <div class="cat-label">{cat.label}</div>
                <div class="cat-subtitle">{cat.subtitle}</div>
              </div>
              {cat.count > 0
                ? <span class="cat-count">{cat.count} demo{cat.count !== 1 ? 's' : ''}</span>
                : <span class="cat-soon">Soon</span>
              }
            </div>

            <p class="cat-desc">{cat.description}</p>

            {cat.tag && <p class="cat-tag">{cat.tag}</p>}

            {cat.count > 0 && (
              <div class="cat-cta">
                <span class="cat-cta-label">Δες τα demos</span>
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 6h8M6 2l4 4-4 4"/>
                </svg>
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p>© {new Date().getFullYear()} Instatok</p>
      <p>Demos for review only — not for public distribution</p>
    </footer>

  </div>
</ShowcaseBase>
